# Copy this file to .env for local runs. .env is gitignored, so it never gets committed.
# On GitHub, add the same names as repository secrets instead.
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BLUESKY_USERNAME=
BLUESKY_PASSWORD=

# LinkedIn (optional; see scripts/linkedin_login.py). Only the access token goes to GitHub.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# Optional
NCBI_API_KEY=
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
